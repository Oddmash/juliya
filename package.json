{
  "name": "@oddmash/juliya",
  "license": "MIT",
  "version": "0.4.1",
  "description": "Locale-aware text wrapping for Korean, English, Japanese and Simplified Chinese",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./ko": { "types": "./dist/core/locales/ko.d.ts", "import": "./dist/core/locales/ko.js" },
    "./en": { "types": "./dist/core/locales/en.d.ts", "import": "./dist/core/locales/en.js" },
    "./ja": { "types": "./dist/core/locales/ja.d.ts", "import": "./dist/core/locales/ja.js" },
    "./zh": { "types": "./dist/core/locales/zh.d.ts", "import": "./dist/core/locales/zh.js" },
    "./browser": { "types": "./dist/dom/index.d.ts", "import": "./dist/dom/index.js" },
    "./dom": { "types": "./dist/dom/index.d.ts", "import": "./dist/dom/index.js" },
    "./react": { "types": "./dist/adapters/react/index.d.ts", "import": "./dist/adapters/react/index.js" },
    "./react/server": { "types": "./dist/adapters/react/server.d.ts", "import": "./dist/adapters/react/server.js" },
    "./vue": { "types": "./dist/adapters/vue/index.d.ts", "import": "./dist/adapters/vue/index.js" },
    "./svelte": { "types": "./dist/adapters/svelte/index.d.ts", "import": "./dist/adapters/svelte/index.js" }
  },
  "files": ["dist", "README.md", "NOTICE.md"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:next": "pnpm run build && pnpm --dir test/next-app run build",
    "test:hydration": "pnpm run build && pnpm --dir test/next-app run test:hydration",
    "test:frameworks": "pnpm run build && pnpm --dir test/framework-app test",
    "test:browser": "pnpm run test:next && pnpm --dir test/next-app run test:browser",
    "test:package": "pnpm run build && node --test test/package.mjs",
    "build:site": "pnpm run build && pnpm --dir site run build",
    "test:site": "pnpm run build:site && node --test test/site.mjs",
    "prepack": "pnpm run build"
  },
  "engines": { "node": ">=20" },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.2",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  },
  "repository": { "type": "git", "url": "git+https://github.com/Oddmash/juliya.git" }
}
